# ==============================================================================
# ENVIRONMENT CONFIGURATION: iPod-Manager-Music (Apple Music -> Rockbox)
# ==============================================================================
# Copy this file to '.env' in the root directory and fill in your values.
# Command: cp .env.example .env  (or copy/paste manually on Windows)
# ==============================================================================

# 1. APPLE MUSIC WEB AUTHENTICATION
# ------------------------------------------------------------------------------
# BEARER_TOKEN (Developer Token / JWT):
# Public authorization token used by the Apple Music Web Player.
BEARER_TOKEN=""

# MEDIA_USER_TOKEN (Music-User-Token):
# Personal user session token that grants access to your private library and playlists.
MEDIA_USER_TOKEN=""


# 2. EXECUTION MODE
# ------------------------------------------------------------------------------
# AUTO_MODE:
# Defines whether the script runs automatically or in interactive menu mode.
#
# Options:
#  - true  : Automatic Mode.
#            Skips console prompts, downloads your entire library and playlists,
#            checks if the iPod is connected, syncs, and exits.
#  - false : Interactive Mode.
#            Displays an interactive menu in the terminal to select specific playlists.
AUTO_MODE=true